    <!-- Stored layer names are resource keys resolved at display time
         (AGENTS.md, "Generated layer names are a closed grammar"). The
         crash-recovery scan that reopens a painting matches the stored form
         "@string/layer_default N" — deliberately untranslatable, per
         12-roadmap.md step 3b: a translated default would let names written
         under one locale escape the scan under another, and the counter
         would reissue a live name. The display resolver (step 6) appends the
         number. -->
    <string name="layer_default" translatable="false">Layer</string>
