<?xml version="1.0" encoding="utf-8"?>
<!-- No permissions, deliberately: the app is fully offline (PLAN.md §9).
     Paintings reach the gallery through MediaStore inserts and updates of
     the app's own items, which need no permission on API 29+ (the minSdk,
     ADR 0002). Nothing else in the app touches anything outside its own
     storage. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".BangniApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.BangniDraw"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="tiramisu">

        <!-- Single activity. Configuration changes are handled in place so
             a rotation, fold or multi-window resize never tears down the
             GL canvas mid-stroke (docs/plan/02-architecture.md). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Serves the share sheet's staged PNG/JPEG copies and nothing else:
             file_paths.xml exposes only cacheDir/share
             (docs/plan/06-document-and-persistence.md §9.5). Not exported;
             receivers get per-URI read grants from the share intent. No
             permission is involved — this stays within PLAN.md §9's
             no-permissions promise. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
