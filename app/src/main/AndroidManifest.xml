<?xml version="1.0" encoding="utf-8"?>
<!-- No permissions, deliberately: the app is fully offline (PLAN.md §9).
     Paintings reach the gallery through MediaStore inserts and updates of
     the app's own items, which need no permission on API 29+ (the minSdk,
     ADR 0002). Nothing else in the app touches anything outside its own
     storage. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".BangniApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.BangniDraw"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="tiramisu">

        <!-- Single activity. Configuration changes are handled in place so
             a rotation, fold or multi-window resize never tears down the
             GL canvas mid-stroke (docs/plan/02-architecture.md). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
