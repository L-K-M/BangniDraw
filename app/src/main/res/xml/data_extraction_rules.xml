<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ backup/transfer rules; mirrors backup_rules.xml, including
     why saved paintings are absent: they stay on the device (and in the
     gallery, which the system backs up on its own terms). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
